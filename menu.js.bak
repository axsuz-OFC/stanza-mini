import { cmd } from '../command.js';
import config from '../config.js';
import { commands } from '../command.js';

cmd({
    pattern: "menu",
    alias: ["help", "list"],
    desc: "Show bot commands",
    category: "main"
}, async (zanta, mek, m, { from, reply }) => {
    
    const totalCmds = commands.length;
    const uptime = process.uptime();
    const minutes = Math.floor(uptime / 60);
    const seconds = Math.floor(uptime % 60);

    // ඔයා ඉල්ලපු විදියට හදපු මෙනු එකේ උඩ කොටස
    let menuText = `╭━〔 ꜱᴛᴀɴᴢᴀ_ᴍɪɴɪ 〕━➢\n` +
        `┃❍ \`👑 𝖮𝗐𝗇𝖾𝗋\` : Adithya PRamoD\n` +
        `┃❍ \`⚙️ 𝖬𝗈𝖽𝖾\` : PRIVATE\n` +
        `┃❍ \`🔣 𝖯𝗋𝖾𝖿𝗂𝗑\` : ${config.PREFIX}\n` +
        `┃❍ \`📚 𝖢𝗈𝗆𝗆𝖺𝗇𝖽𝗌\` : ${totalCmds}\n` +
        `╰━━━━━━━━━━━━━━➢\n` +
        `╭━〔 *𝗦𝗬𝗦𝗧𝗘𝗠 𝗦𝗧𝗔𝗧𝗦* 〕━➢\n` +
        `┃❍ \`⏱ 𝖴𝗉𝗍𝗂𝗆𝖾\` : ${minutes}m ${seconds}s\n` +
        `┃❍ \`🚀 𝖫𝖺𝗍𝖾𝗇𝖼𝗒\` : ${Date.now() - mek.messageTimestamp * 1000}ms\n` +
        `┃❍ \`💻 𝖯𝗅𝖺𝗍𝖿𝗈𝗋𝗆\` : AXsUZ\n` +
        `┃❍ \`🤖 𝖵𝖾𝗋𝗌𝗂𝗈𝗇\` : 1.0.2\n` +
        `╰━━━━━━━━━━━━━━➢\n\n` +
        `🔻ꜱᴇʟᴇᴄᴛ ᴄᴀᴛᴇɢᴏʀʏ ʙᴇʟʟᴏᴡ\n` +
        `© ꜱᴛᴀɴᴢᴀ_ᴍɪɴɪ`;

    // WhatsApp Interactive Buttons එක හදනවා
    const buttons = [
        { buttonId: 'menu_download', buttonText: { displayText: '📥 DOWNLOAD' }, type: 1 },
        { buttonId: 'menu_media', buttonText: { displayText: '🎨 MEDIA' }, type: 1 },
        { buttonId: 'menu_main', buttonText: { displayText: '🎯 MAIN' }, type: 1 }
    ];

    const buttonMessage = {
        image: { url: 'https://raw.githubusercontent.com/Akashkavindu/MINI-BOT-SOURCE/main/zanta.png' }, // ඔයාට කැමති image URL එකක් දාන්න
        caption: menuText,
        footer: 'ꜱᴛᴀɴᴢᴀ_ᴍɪɴɪ',
        buttons: buttons,
        headerType: 4
    };

    await zanta.sendMessage(from, buttonMessage, { quoted: mek });
});

// --- බොත්තම් එබුවම වැඩ කරන කමාන්ඩ්ස් ---

// Download බොත්තම එබුවම
cmd({ pattern: "menu_download", dontAddCommandList: true }, async (zanta, mek, m, { from }) => {
    let text = `╭━〔 *📥 DOWNLOAD MENU* 〕━➢\n`;
    commands.forEach((c) => {
        if (c.category === 'download' && c.pattern) text += `┃❍ ${config.PREFIX}${c.pattern}\n`;
    });
    text += `╰━━━━━━━━━━━━━━➢`;
    await zanta.sendMessage(from, { text: text }, { quoted: mek });
});

// Media/AI බොත්තම එබුවම
cmd({ pattern: "menu_media", dontAddCommandList: true }, async (zanta, mek, m, { from }) => {
    let text = `╭━〔 *🎨 MEDIA & AI MENU* 〕━➢\n`;
    commands.forEach((c) => {
        if (c.category === 'ai' || c.category === 'tools') text += `┃❍ ${config.PREFIX}${c.pattern}\n`;
    });
    text += `╰━━━━━━━━━━━━━━➢`;
    await zanta.sendMessage(from, { text: text }, { quoted: mek });
});